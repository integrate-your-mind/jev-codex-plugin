{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/integrate-your-mind/jev-codex-plugin/blob/main/benchmarks/cross-agent/record.schema.json",
  "title": "Jev cross-agent comparison records",
  "description": "Dependency-free normalized plan and trial records consumed by compare.mjs.",
  "oneOf": [
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/trial" }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "safeArm": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$" },
    "fingerprint": { "type": "string", "minLength": 1, "maxLength": 300 },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetFingerprint", "harnessFingerprint", "imageFingerprint", "environmentMode", "resourceBudget", "timeBudget", "networkPolicy"],
      "properties": {
        "datasetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "harnessFingerprint": { "$ref": "#/$defs/fingerprint" },
        "imageFingerprint": { "type": ["string", "null"], "minLength": 1, "maxLength": 300 },
        "environmentMode": { "enum": ["native_shared", "container"] },
        "resourceBudget": {
          "type": "object", "additionalProperties": false,
          "required": ["cpuMs", "memoryBytes", "diskBytes"],
          "properties": {
            "cpuMs": { "type": ["integer", "null"], "minimum": 1 },
            "memoryBytes": { "type": ["integer", "null"], "minimum": 1 },
            "diskBytes": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "timeBudget": {
          "type": "object", "additionalProperties": false, "required": ["basis", "valueMs"],
          "properties": { "basis": { "enum": ["per_turn", "per_trial"] }, "valueMs": { "type": ["integer", "null"], "minimum": 1 } }
        },
        "networkPolicy": {
          "type": "object", "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "$ref": "#/$defs/nonEmpty" }, "allowlistFingerprint": { "$ref": "#/$defs/fingerprint" } }
        }
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["agent", "agentVersion", "model", "provider", "effort", "pluginEnabled"],
      "properties": {
        "agent": { "$ref": "#/$defs/nonEmpty" },
        "agentVersion": { "$ref": "#/$defs/nonEmpty" },
        "model": { "$ref": "#/$defs/nonEmpty" },
        "provider": { "$ref": "#/$defs/nonEmpty" },
        "effort": { "$ref": "#/$defs/nonEmpty" },
        "pluginEnabled": { "type": "boolean" },
        "pluginVersion": { "type": ["string", "null"] }
      }
    },
    "planTrial": {
      "type": "object", "additionalProperties": false,
      "required": ["trialId", "taskId", "inputHash", "repetition", "arm", "plannedIdentity"],
      "properties": {
        "trialId": { "$ref": "#/$defs/nonEmpty" },
        "taskId": { "$ref": "#/$defs/nonEmpty" },
        "inputHash": { "$ref": "#/$defs/nonEmpty" },
        "repetition": { "type": "integer", "minimum": 1 },
        "arm": { "$ref": "#/$defs/safeArm" },
        "plannedIdentity": { "$ref": "#/$defs/identity" }
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "comparison", "cohort", "trials"],
      "properties": {
        "schemaVersion": { "const": "jev-cross-agent-comparison-plan-v1" },
        "comparison": {
          "type": "object", "additionalProperties": false,
          "required": ["factor", "cohortId", "armOrder", "timingMetric"],
          "properties": {
            "factor": { "enum": ["agent", "treatment"] },
            "cohortId": { "$ref": "#/$defs/nonEmpty" },
            "armOrder": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/safeArm" } },
            "timingMetric": { "enum": ["agent_turn_wall_ms", "agent_turn_sum_ms"] }
          }
        },
        "cohort": { "$ref": "#/$defs/cohort" },
        "trials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/planTrial" } }
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "passed"],
      "properties": { "status": { "enum": ["passed", "failed", "not_run", "error"] }, "passed": { "type": ["boolean", "null"] } }
    },
    "completion": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "completed"],
      "properties": { "status": { "enum": ["completed", "failed", "timeout", "cancelled", "not_run", "error"] }, "completed": { "type": "boolean" } }
    },
    "trial": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "trialId", "taskId", "inputHash", "repetition", "arm", "plannedIdentity", "observedIdentity", "cohort", "artifactVerifier", "agentCompletion", "timing", "tokens", "billing", "infrastructureError"],
      "properties": {
        "schemaVersion": { "const": "jev-cross-agent-trial-v1" },
        "trialId": { "$ref": "#/$defs/nonEmpty" },
        "taskId": { "$ref": "#/$defs/nonEmpty" },
        "inputHash": { "$ref": "#/$defs/nonEmpty" },
        "repetition": { "type": "integer", "minimum": 1 },
        "arm": { "$ref": "#/$defs/safeArm" },
        "plannedIdentity": { "$ref": "#/$defs/identity" },
        "observedIdentity": { "$ref": "#/$defs/identity" },
        "cohort": { "$ref": "#/$defs/cohort" },
        "artifactVerifier": { "$ref": "#/$defs/outcome" },
        "agentCompletion": { "$ref": "#/$defs/completion" },
        "timing": {
          "type": "object", "additionalProperties": false, "required": ["metric", "valueMs"],
          "properties": { "metric": { "enum": ["agent_turn_wall_ms", "agent_turn_sum_ms"] }, "valueMs": { "type": ["number", "null"], "minimum": 0 } }
        },
        "tokens": {
          "type": "object", "additionalProperties": false, "required": ["input", "cachedInput", "output"],
          "properties": {
            "input": { "type": ["integer", "null"], "minimum": 0 },
            "cachedInput": { "type": ["integer", "null"], "minimum": 0 },
            "output": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "billing": {
          "type": "object", "additionalProperties": false, "required": ["actualBilledUsd", "source"],
          "properties": { "actualBilledUsd": { "type": ["number", "null"], "minimum": 0 }, "source": { "$ref": "#/$defs/nonEmpty" } }
        },
        "infrastructureError": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["stage", "code", "message"],
          "properties": { "stage": { "$ref": "#/$defs/nonEmpty" }, "code": { "$ref": "#/$defs/nonEmpty" }, "message": { "$ref": "#/$defs/nonEmpty" } }
        }
      }
    }
  }
}
