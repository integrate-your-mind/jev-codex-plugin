  "semantics": {
    "no_fit": "A caller-defined available candidate used only when every other available catalog action is unsuitable.",
    "insufficient_evidence": "A provider-reserved abstention; it is not a no_fit candidate and grants no permission to act.",
    "actionEvidence": "Passing status is derived from sandbox artifacts and postconditions, never an action return value or caller report.",
    "surfaceBoundary": "Classification and outcome recording are different contracts; outcome verification here is harness-only."
  }
