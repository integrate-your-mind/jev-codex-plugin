@@ -0,0 +1,430 @@
+import {spawn} from 'node:child_process';
+import {createHash} from 'node:crypto';
+import fs from 'node:fs';
+import {syncBuiltinESMExports} from 'node:module';
+import {mkdir, mkdtemp, readFile, readdir, rm, writeFile} from 'node:fs/promises';
+import {join} from 'node:path';
+import {setTimeout as delay} from 'node:timers/promises';
+import {after, before, test} from 'node:test';
+import assert from 'node:assert/strict';
+import {configurePolicy} from '../src/policy.js';
+import {runDecisionHook, type DecisionInput, type DecisionService} from '../src/decision-hook.js';
+import {loadTaskContext, updateTaskContext} from '../src/task-context.js';
+
+type Env = NodeJS.ProcessEnv;
+let root: string;
+
+before(async () => { root = await mkdtemp(join(process.env.TMPDIR ?? join(process.cwd(), 'work'), 'restart-recovery-')); });
+after(async () => { await rm(root, {recursive: true, force: true}); });
+
+function digest(value: string): string { return createHash('sha256').update(value).digest('hex'); }
+function env(name: string): Env { return {PLUGIN_DATA: join(root, name), JEV_ENABLED: '1', TYPESAFE_API_KEY: 'synthetic-test-key'}; }
+function event(id: string, overrides: Record<string, unknown> = {}): Record<string, unknown> {
+  return {hook_event_name: 'PreToolUse', session_id: 'restart-session', turn_id: 'restart-turn', tool_use_id: id,
+    cwd: process.cwd(), tool_name: 'Bash', tool_input: {command: 'printf restart'}, ...overrides};
+}
+function service(result: Record<string, unknown>, calls: {count: number}): DecisionService {
+  return {async classifyDecision(_input: DecisionInput) { calls.count += 1; return result; }};
+}
+function paths(environment: Env, nativeEvent: Record<string, unknown>) {
+  const session = String(nativeEvent.session_id);
+  const eventId = String(nativeEvent.tool_use_id);
+  const eventName = digest(`PreToolUse\0${session}\0${String(nativeEvent.turn_id)}\0${eventId}`);
+  const directory = join(environment.PLUGIN_DATA!, 'decision-hook-v1', digest(process.cwd()), digest(session));
+  return {directory, marker: join(directory, eventName), invocations: join(directory, 'invocations'), attempts: join(directory, 'attempts')};
+}
+function resolution(rootPath: string, attemptId: string): string {
+  const parts = rootPath.split('/');
+  const name = parts.pop()!;
+  return `${parts.join('/')}/${name}.${attemptId}.resolution`;
+}
+async function enable(environment: Env, cap: number | null = null): Promise<void> {
+  await configurePolicy({enabled: true, scope: 'workspaces', workspaces: [process.cwd()], maxHookCallsPerSession: cap}, environment);
+}
+async function runCrashChild(environment: Env, nativeEvent: Record<string, unknown>, cap: number | null = null): Promise<number> {
+  const script = `
+    const {configurePolicy} = await import('./src/policy.ts');
+    const {runDecisionHook} = await import('./src/decision-hook.ts');
+    const env = {PLUGIN_DATA: process.env.PLUGIN_DATA, JEV_ENABLED: '1', TYPESAFE_API_KEY: 'synthetic-test-key'};
+    const event = JSON.parse(process.env.RESTART_EVENT_JSON);
+    await configurePolicy({enabled:true, scope:'workspaces', workspaces:[process.cwd()], maxHookCallsPerSession:JSON.parse(process.env.RESTART_CAP)}, env);
+    await runDecisionHook(JSON.stringify(event), {env, service:{classifyDecision(){ process.exit(91); }}});
+  `;
+  return await new Promise(resolve => {
+    const child = spawn(process.execPath, ['--import', 'tsx', '--eval', script], {
+      cwd: process.cwd(), env: {...process.env, ...environment, RESTART_EVENT_JSON: JSON.stringify(nativeEvent), RESTART_CAP: JSON.stringify(cap)}, stdio: ['ignore', 'ignore', 'pipe'],
+    });
+    child.on('error', () => resolve(-1));
+    child.on('exit', code => resolve(code ?? -1));
+  });
+}
+
+test('reclaims a crash-left pending claim and records a new attempt receipt', async () => {
+  const environment = env('crash');
+  const nativeEvent = event('crash-event');
+  const exitCode = await runCrashChild(environment, nativeEvent);
+  assert.equal(exitCode, 91);
+  const claimPaths = paths(environment, nativeEvent);
+  const pending = JSON.parse(await readFile(claimPaths.marker, 'utf8')) as Record<string, unknown>;
+  assert.equal(pending.status, 'pending');
+  assert.equal(typeof pending.ownerToken, 'string');
+  const calls = {count: 0};
+  const result = await runDecisionHook(JSON.stringify(nativeEvent), {env: environment, service: service({status: 'assessed', choice: 'proceed'}, calls)});
+  assert.match(result.hookSpecificOutput?.additionalContext ?? '', /status=assessed; decision=proceed/);
+  assert.equal(calls.count, 1);
+  const completed = JSON.parse(await readFile(claimPaths.marker, 'utf8')) as Record<string, unknown>;
+  assert.equal(completed.status, 'pending');
+  const successorPath = resolution(claimPaths.marker, String(pending.attemptId));
+  const successor = JSON.parse(await readFile(successorPath, 'utf8')) as Record<string, unknown>;
+  assert.equal(successor.status, 'pending');
+  const terminalPath = resolution(claimPaths.marker, String(successor.attemptId));
+  const terminal = JSON.parse(await readFile(terminalPath, 'utf8')) as Record<string, unknown>;
+  assert.equal(terminal.status, 'completed');
+  assert.equal(terminal.assessmentStatus, 'assessed');
+  assert.equal(terminal.delivery, 'unknown');
+  assert.equal(typeof terminal.inputDigest, 'string');
+  const receipts = await readdir(claimPaths.invocations);
+  assert.equal(receipts.length, 1);
+  assert.match(receipts[0]!, /-[a-f0-9-]{36}\.json$/);
