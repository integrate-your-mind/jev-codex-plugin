+  await runDecisionHook(nativeEvent, {env: environment, service: fake});
+  const replay = await runDecisionHook(nativeEvent, {env: environment, service: fake});
+  assert.match(replay.hookSpecificOutput?.additionalContext ?? '', /status=assessed; decision=proceed; confidence=0\.93/);
+  assert.match(replay.hookSpecificOutput?.additionalContext ?? '', /replayed=true; delivery=unknown/);
+  assert.equal(calls.count, 1);
+  const changed = await runDecisionHook({...nativeEvent, tool_input: {command: 'different action'}}, {env: environment, service: fake});
+  assert.match(changed.hookSpecificOutput?.additionalContext ?? '', /status=unavailable; reason=stored_assessment_mismatch; delivery=unknown/);
