+      // Publication can lose to another importer of this same event. Never
+      // advance past that slot before reading its immutable winner.
+      try {
+        const handle = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+        try {
+          const info = await handle.stat();
+          if (info.isFile() && info.size <= 1024) {
+            const value: unknown = JSON.parse(await handle.readFile('utf8'));
+            if (isRecord(value) && value.version === 1 && value.event === eventId) return reservationId;
+          }
+        } finally { await handle.close(); }
+      } catch { return undefined; }
+    }
+    return undefined;
+  };
+  // Old roots and roots created while unlimited already consumed an event.
+  // Import them into real exclusive capacity before admitting a new event.
+  // Version-2 finite roots are elected before admission and must not be
+  // mistaken for already-admitted legacy roots.
+  const entries = await readdir(sessionDirectory, {withFileTypes: true});
