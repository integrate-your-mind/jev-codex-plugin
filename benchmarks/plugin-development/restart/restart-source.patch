+  // publication race at the same index: duplicate importers/event callers
+  // then observe the winner instead of consuming another slot.
+  const reserve = async (eventId: string): Promise<string | undefined> => {
+    for (let index = 0; index < cap; index++) {
+      if (Date.now() >= deadline) return undefined;
+      const reservationId = `slot-${index}`;
+      const path = join(directory, reservationId);
+      let missing = false;
+      try {
+        const handle = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+        try {
+          const info = await handle.stat();
+          if (info.isFile() && info.size <= 1024) {
+            const value: unknown = JSON.parse(await handle.readFile('utf8'));
+            if (isRecord(value) && value.version === 1 && value.event === eventId) return reservationId;
+          }
+        } finally { await handle.close(); }
+      } catch (error) { missing = (error as NodeJS.ErrnoException).code === 'ENOENT'; }
