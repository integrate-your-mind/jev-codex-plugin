+
+function blockFirstLink(destination: string | ((path: string) => boolean)) {
+  const original = fs.promises.link;
+  let enter!: () => void;
+  let release!: () => void;
+  let finish!: () => void;
+  let intercepted = false;
+  const entered = new Promise<void>(resolve => {enter = resolve;});
+  const released = new Promise<void>(resolve => {release = resolve;});
+  const finished = new Promise<void>(resolve => {finish = resolve;});
+  fs.promises.link = async (source, target) => {
+    if (!intercepted && (typeof destination === 'string' ? String(target) === destination : destination(String(target)))) {
+      intercepted = true;
+      enter();
+      await released;
+      try { return await original(source, target); } finally { finish(); }
+    }
+    return original(source, target);
+  };
+  syncBuiltinESMExports();
+  return {entered, finished, release, restore() {release(); fs.promises.link = original; syncBuiltinESMExports();}};
+}
+
+async function tickets(environment: Env, nativeEvent: Record<string, unknown>): Promise<Array<{event: string}>> {
+  const directory = join(paths(environment, nativeEvent).directory, 'reservations');
+  return Promise.all((await readdir(directory)).filter(name => /^slot-[0-9]+$/.test(name)).map(async name => JSON.parse(await readFile(join(directory, name), 'utf8')) as {event: string}));
+}
