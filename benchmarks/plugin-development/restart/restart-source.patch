+  const assessment = storedAssessment(result);
+  if (!assessment) return false;
+  const terminal: EventClaimRecord = {
+    ...current.record,
+    version: 2,
+    status: 'completed',
+    completedAt: Date.now(),
+    assessmentStatus: assessment.status,
+    assessment,
+    inputDigest,
+    digestVersion: 'hook-semantic-v1',
+    delivery: 'unknown',
+  };
+  // A successor and a terminal assessment compete for one immutable resolution
+  // slot. Whichever exclusive publication wins is the generation's outcome.
+  return await publishExclusive(terminalPath, JSON.stringify(terminal) + '\n');
+}
