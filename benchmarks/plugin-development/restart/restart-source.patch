+  await writeFile(claimPaths.marker, '');
+  const calls = {count: 0};
+  assert.deepEqual(await runDecisionHook(JSON.stringify(nativeEvent), {env: environment, service: service({status: 'assessed', choice: 'proceed'}, calls)}), {});
+  assert.equal(calls.count, 0);
+});
