+function semanticDigest(event: NormalizedEvent, input?: DecisionInput, taskContext?: TaskContextRecord): string {
+  // Only the plugin-owned task timestamp is non-semantic. User fields with
+  // names such as updatedAt remain part of the raw event fingerprint.
+  const taskView = (value: unknown): unknown => {
+    if (!isRecord(value)) return value;
+    const {updatedAt: _timestamp, ...facts} = value;
+    return facts;
+  };
+  const serializedTask = (value: unknown): unknown => {
+    if (typeof value !== 'string') return value;
+    try {
+      const parsed: unknown = JSON.parse(value);
+      if (isRecord(parsed) && 'rootObjective' in parsed && 'version' in parsed) return canonical(taskView(parsed));
+    } catch { /* an ordinary prompt remains literal evidence */ }
+    return value;
+  };
+  let context: unknown = input?.context;
+  try {
+    const parsed: unknown = JSON.parse(input?.context ?? 'null');
+    if (isRecord(parsed)) context = {...parsed, taskPrompt: serializedTask(parsed.taskPrompt), taskContext: taskView(parsed.taskContext)};
+  } catch { /* preserve any non-JSON context verbatim */ }
+  const view = taskContext ? taskView(JSON.parse(renderTaskContext(taskContext) ?? '{}')) : undefined;
+  const evidence = input?.evidence.map(item => item.id === 'task.prompt' ? {...item, text: serializedTask(item.text)} : item);
+  return hash(JSON.stringify(canonical({version: 'hook-semantic-v1', event: event.raw, input: input ? {...input, context, evidence} : undefined, taskContext: view})));
+}
