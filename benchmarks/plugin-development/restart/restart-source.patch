+test('retains uncertain receipts and gives a retry a distinct attempt identity', async () => {
+  const environment = env('uncertain');
+  const nativeEvent = event('uncertain-event');
+  await enable(environment);
+  const firstCalls = {count: 0};
+  const first = await runDecisionHook(JSON.stringify(nativeEvent), {env: environment, service: service({status: 'unavailable', reasonCode: 'service_error'}, firstCalls)});
+  assert.match(first.hookSpecificOutput?.additionalContext ?? '', /status=unavailable/);
+  const claimPaths = paths(environment, nativeEvent);
+  const pending = JSON.parse(await readFile(claimPaths.marker, 'utf8')) as Record<string, unknown>;
+  await writeFile(claimPaths.marker, JSON.stringify({...pending, ownerPid: 999999999, leaseUntil: Date.now() - 1}) + '\n');
+  const secondCalls = {count: 0};
+  const second = await runDecisionHook(JSON.stringify(nativeEvent), {env: environment, service: service({status: 'assessed', choice: 'proceed'}, secondCalls)});
+  assert.match(second.hookSpecificOutput?.additionalContext ?? '', /status=assessed/);
+  assert.equal(firstCalls.count, 1);
+  assert.equal(secondCalls.count, 1);
+  const receipts = (await readdir(claimPaths.invocations)).sort();
+  assert.equal(receipts.length, 2);
+  assert.equal(receipts[0]!.includes('-'), true);
+  const statuses = await Promise.all(receipts.map(async name => (JSON.parse(await readFile(join(claimPaths.invocations, name), 'utf8')) as Record<string, unknown>).assessmentStatus));
+  assert.deepEqual(new Set(statuses), new Set(['unavailable', 'assessed']));
+  assert.equal((JSON.parse(await readFile(claimPaths.marker, 'utf8')) as Record<string, unknown>).status, 'pending');
+  const successorPath = resolution(claimPaths.marker, String(pending.attemptId));
+  const successor = JSON.parse(await readFile(successorPath, 'utf8')) as Record<string, unknown>;
+  assert.equal((JSON.parse(await readFile(resolution(claimPaths.marker, String(successor.attemptId)), 'utf8')) as Record<string, unknown>).status, 'completed');
+});
