+    const current = await readEventClaim(path);
+    if (current.kind === 'missing') return {kind: 'leaf', path, retry};
+    if (current.kind === 'legacy') return {kind: 'legacy'};
+    if (current.kind === 'completed') return current;
+    const nextPath = resolutionPath(initialPath, current.record.attemptId);
+    const next = await readEventClaim(nextPath);
