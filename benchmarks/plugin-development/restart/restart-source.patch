+test('a timed-out owner cannot overwrite a later owner completion', async () => {
+  const environment = env('late-timeout');
+  const nativeEvent = event('late-event');
+  await enable(environment);
+  let release!: (value: Record<string, unknown>) => void;
+  const pending = new Promise<Record<string, unknown>>(resolve => {release = resolve;});
+  const first = await runDecisionHook(JSON.stringify(nativeEvent), {env: environment, hookTimeoutMs: 30, service: {async classifyDecision() { return pending; }}});
+  assert.match(first.hookSpecificOutput?.additionalContext ?? '', /status=unavailable; reason=hook_timeout/);
+  const claimPaths = paths(environment, nativeEvent);
+  const oldClaim = JSON.parse(await readFile(claimPaths.marker, 'utf8')) as Record<string, unknown>;
+  await writeFile(claimPaths.marker, JSON.stringify({...oldClaim, ownerPid: 999999998, leaseUntil: Date.now() - 1}) + '\n');
+  const second = await runDecisionHook(JSON.stringify(nativeEvent), {env: environment, service: service({status: 'assessed', choice: 'proceed'}, {count: 0})});
+  assert.match(second.hookSpecificOutput?.additionalContext ?? '', /status=assessed/);
+  release({status: 'assessed', choice: 'reconsider'});
+  await new Promise(resolve => setTimeout(resolve, 10));
+  const completed = JSON.parse(await readFile(claimPaths.marker, 'utf8')) as Record<string, unknown>;
+  assert.equal(completed.status, 'pending');
+  const successorPath = resolution(claimPaths.marker, String(oldClaim.attemptId));
+  const successor = JSON.parse(await readFile(successorPath, 'utf8')) as Record<string, unknown>;
+  assert.notEqual(successor.attemptId, oldClaim.attemptId);
+  assert.equal((JSON.parse(await readFile(resolution(claimPaths.marker, String(successor.attemptId)), 'utf8')) as Record<string, unknown>).status, 'completed');
+});
+
+test('serializes concurrent owners for the same event', async () => {
+  const environment = env('concurrent');
+  const nativeEvent = event('concurrent-event');
+  await enable(environment);
+  const calls = {count: 0};
+  const sharedService: DecisionService = {async classifyDecision() {
+    calls.count += 1;
+    await delay(20);
+    return {status: 'assessed', choice: 'proceed'};
+  }};
+  const results = await Promise.all([
+    runDecisionHook(JSON.stringify(nativeEvent), {env: environment, service: sharedService}),
+    runDecisionHook(JSON.stringify(nativeEvent), {env: environment, service: sharedService}),
+  ]);
+  assert.equal(calls.count, 1);
+  assert.equal(results.filter(result => /status=assessed/.test(result.hookSpecificOutput?.additionalContext ?? '')).length, 1);
+  assert.equal(results.filter(result => Object.keys(result).length === 0).length, 1);
+});
+
