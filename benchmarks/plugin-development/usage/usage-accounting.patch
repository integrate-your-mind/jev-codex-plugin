diff --git a/source/jev-workflows/tests/usage-retention.test.ts b/source/jev-workflows/tests/usage-retention.test.ts
new file mode 100644
index 0000000..82df2e6
--- /dev/null
+++ b/source/jev-workflows/tests/usage-retention.test.ts
@@ -0,0 +1,148 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp, rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {evaluateProvider, fingerprintCredential, ProviderError} from '../src/provider.js';
+import {createService} from '../src/service.js';
+import {readEvaluationUsage} from '../src/accounting.js';
+import type {Question} from '../src/contracts.js';
+import type {Receipt, Store} from '../src/store.js';
+
+const apiKey = 'usage-test-key';
+const usage = {input_tokens: 449, output_tokens: 19};
+const questions: Record<string, Question> = {
+  severity: {type: 'score', instructions: 'Rate severity', criteria: [{label: 'low'}, {label: 'high'}]},
+};
+const batch = {state: {task: 'synthetic usage retention'}, questions, mode: 'evaluate'};
+function invalidScore(reportedUsage: unknown = usage) {
+  return {model: 'jev-1.13.0', answers: {severity: {
+    type: 'score', score: 0.01, legend: {'0': {label: 'low'}, '1': {label: 'high'}},
+    probabilities: {'0': 1, '1': 0}, confidence: 0.9,
+  }}, usage: reportedUsage};
+}
+function response(body: unknown, headers: HeadersInit = {'x-typesafe-request-id': 'req_invalid_score'}) {
+  return new Response(JSON.stringify(body), {status: 200, headers});
+}
+class MemoryStore implements Store {
+  receipts: Receipt[] = [];
+  reservations = 0;
+  async reserve() { this.reservations++; return true; }
+  async save(receipt: Receipt) { this.receipts.push(receipt); }
+}
+
+test('semantic Score rejection retains valid usage and safe request identity without accepting the answer', async () => {
+  await assert.rejects(evaluateProvider({state: {}, questions, apiKey, timeoutMs: 1000,
+    fetchFn: async () => response(invalidScore()),
+  }), error => {
+    assert.ok(error instanceof ProviderError);
+    assert.equal(error.code, 'invalid_response');
+    assert.equal(error.transport?.responseValidationFailure, 'score_value_invalid');
+    assert.equal(error.transport?.responseStatus, 200);
+    assert.equal(error.transport?.validatedResponse, false);
+    assert.equal(error.transport?.providerRequestId, 'req_invalid_score');
+    assert.equal(error.transport?.providerRequestIdHeader, 'x-typesafe-request-id');
+    assert.deepEqual(error.usage, usage);
+    assert.equal(Object.hasOwn(error, 'answers'), false);
+    assert.equal(JSON.stringify(error).includes('probabilities'), false);
+    return true;
+  });
+});
+
+test('batch service returns and saves rejected-response usage without caching or promoting it', async () => {
+  const store = new MemoryStore();
+  let calls = 0;
+  const service = createService({apiKey, store, env: {}, fetchFn: async () => { calls++; return response(invalidScore()); }});
+  for (let attempt = 0; attempt < 2; attempt++) {
+    const result = await service.evaluateDecisions(batch);
+    assert.equal(result.status, 'unavailable');
+    assert.equal(result.reasonCode, 'invalid_response');
+    assert.equal(result.answers, undefined);
+    assert.equal(result.recommendation, undefined);
+    assert.equal(result.cached, undefined);
+    assert.deepEqual(result.usage, usage);
+    assert.equal(result.transport?.validatedResponse, false);
+    assert.equal(result.transport?.providerRequestId, 'req_invalid_score');
+    assert.equal(result.receiptPersisted, true);
+    assert.deepEqual(store.receipts[attempt]?.usage, usage);
+    assert.equal(store.receipts[attempt]?.status, 'unavailable');
+    assert.equal(store.receipts[attempt]?.answers, undefined);
+  }
+  assert.equal(calls, 2);
+  assert.equal(store.reservations, 2);
+});
+
+test('single-decision service also retains usage when choice semantics reject the response', async () => {
+  const store = new MemoryStore();
+  const service = createService({apiKey, store, env: {}, fetchFn: async (_url, init) => {
+    const payload = JSON.parse(String(init?.body)) as {questions: Record<string, {criteria: Record<string, unknown>}>};
+    const probabilities = Object.fromEntries(Object.keys(payload.questions.decision!.criteria).map(id => [id, 0]));
+    return response({model: 'jev-1.13.0', answers: {decision: {type: 'choice', choice: 'proceed', confidence: 0.9, probabilities}}, usage});
+  }});
+  const result = await service.classifyDecision({domain: 'tool', question: 'Proceed?', context: 'synthetic',
+    candidates: [{id: 'proceed', description: 'Proceed'}], evidence: [], mode: 'evaluate'});
+  assert.equal(result.status, 'unavailable');
+  assert.equal(result.transport?.responseValidationFailure, 'probability_sum_invalid');
+  assert.equal(result.transport?.validatedResponse, false);
+  assert.equal(result.choice, undefined);
+  assert.equal(result.recommendation, undefined);
+  assert.deepEqual(result.usage, usage);
+  assert.deepEqual(store.receipts[0]?.usage, usage);
+});
+
+test('invalid or absent usage is never retained even when HTTP status and request identity are known', async () => {
+  for (const invalid of [undefined, null, {input_tokens: -1, output_tokens: 19},
+    {input_tokens: 449.5, output_tokens: 19}, {input_tokens: '449', output_tokens: 19},
+    {input_tokens: Number.MAX_SAFE_INTEGER + 1, output_tokens: 19}, {input_tokens: 449},
+    {...usage, secret: 'must-not-retain'}]) {
+    const store = new MemoryStore();
+    const body = invalidScore();
+    body.usage = invalid;
+    const result = await createService({apiKey, store, env: {}, fetchFn: async () => response(body)}).evaluateDecisions(batch);
+    assert.equal(result.status, 'unavailable');
+    assert.equal(result.transport?.responseValidationFailure, 'response_schema');
+    assert.equal(result.transport?.providerRequestId, 'req_invalid_score');
+    assert.equal(result.usage, undefined);
+    assert.equal(store.receipts[0]?.usage, undefined);
+    assert.equal(JSON.stringify(result).includes('must-not-retain'), false);
+  }
+});
+
+test('invalid-response request IDs still use allowlisted, bounded, credential-safe header selection', async () => {
+  const variants: Array<{headers: Record<string, string>; id: string | null; header: string | null}> = [
+    {headers: {'x-typesafe-request-id': apiKey, 'x-request-id': 'req_safe_fallback'}, id: 'req_safe_fallback', header: 'x-request-id'},
+    {headers: {'x-typesafe-request-id': 'https://unsafe.example/request', 'x-request-id': 'x'.repeat(257)}, id: null, header: null},
+    {headers: {'request-id': 'req_last_header'}, id: 'req_last_header', header: 'request-id'},
+  ];
+  for (const variant of variants) {
+    const result = await createService({apiKey, store: new MemoryStore(), env: {},
+      fetchFn: async () => response(invalidScore(), variant.headers),
+    }).evaluateDecisions(batch);
+    assert.deepEqual(result.usage, usage);
+    assert.equal(result.transport?.providerRequestId, variant.id);
+    assert.equal(result.transport?.providerRequestIdHeader, variant.header);
+    assert.equal(result.transport?.validatedResponse, false);
+    assert.equal(JSON.stringify(result).includes(apiKey), false);
+  }
+});
+
+test('retained rejected-response usage does not increment validated evaluations or establish billing', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'jev-usage-retention-'));
+  try {
+    const result = await createService({apiKey, env: {PLUGIN_DATA: root}, fetchFn: async () => response(invalidScore())}).evaluateDecisions(batch);
+    assert.equal(result.receiptPersisted, true);
+    const observed = await readEvaluationUsage(root, fingerprintCredential(apiKey), new Date());
+    assert.equal(observed.totals.receipts, 1);
+    assert.equal(observed.totals.unavailable, 1);
+    assert.equal(observed.totals.assessed, 0);
+    assert.equal(observed.totals.abstained, 0);
+    assert.equal(observed.totals.validatedEvaluations, 0);
+    assert.equal(observed.totals.httpSuccessResponses, 1);
+    assert.equal(observed.totals.reportedInputTokens, 449);
+    assert.equal(observed.totals.reportedOutputTokens, 19);
+    assert.equal(observed.uniqueProviderRequestIds, 1);
+    assert.equal(observed.providerBilledRequests, null);
+    assert.equal(observed.providerBilledTokens, null);
+    assert.equal(observed.billingReconciled, false);
+  } finally { await rm(root, {recursive: true, force: true}); }
+});
